    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Map1
        - /TF1/Frames1
        - /RobotModel1
      Splitter Ratio: 0.5
    Tree Height: 711
